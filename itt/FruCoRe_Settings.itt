[Public]
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseVSync,Title="Vertical Sync",Description="If checked, enables VSync to prevent screen tearing.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseVSync,Title="Sincronia Verticale",Description="Se attivo, abilita il VSync per evitare il tearing dello schermo.")
; EN: Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=UseAA,Title="Enable MSAA",Description="If checked, multisampled anti-aliasing will be enabled.")
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=UseAA,Title="Abilita MSAA",Description="Se attivo, abilita il Multisample Anti-Aliasing (MSAA).")
; EN: Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=NumAASamples,Title="MSAA Samples",Description="Number of samples for multisampled anti-aliasing.",Value(2),Value(4),Value(8))
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=NumAASamples,Title="Campioni MSAA",Description="Numero di campioni per il Multisample Anti-Aliasing (MSAA).",Value(2),Value(4),Value(8))
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MaxAnisotropy,Title="Max Anisotropy",Description="Anisotropic filtering level. Higher values keep textures sharper at an angle.",Value("0=Disabled"),Value("2=2x"),Value("4=4x"),Value("8=8x"),Value("16=16x"))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MaxAnisotropy,Title="Anisotropia Massima",Description="Livello di filtraggio anisotropico. Valori più alti mantengono le texture più nitide se viste di sbieco.",Value("0=Disabilitato"),Value("2=2x"),Value("4=4x"),Value("8=8x"),Value("16=16x"))
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ForceNoSmooth,Title="No Texture Filtering",Description="If checked, disables texture filtering.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ForceNoSmooth,Title="Nessun Filtraggio Texture",Description="Se attivo, disabilita il filtraggio delle texture.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MacroTextures,Title="Macro Textures",Description="If checked, enables macro textures on surfaces.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MacroTextures,Title="Macro Texture",Description="Se attivo, abilita le macro texture sulle superfici.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=DetailTextures,Title="Detail Textures",Description="If checked, enables detail textures on surfaces.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=DetailTextures,Title="Dettagli Texture",Description="Se attivo, abilita le texture di dettaglio sulle superfici.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseGammaCorrection,Title="Gamma Correction",Description="If checked, enables post-process gamma correction.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseGammaCorrection,Title="Correzione Gamma",Description="Se attivo, abilita la correzione gamma in post-processing.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=GammaOffset,Title="Gamma Offset",Description="Added to the base gamma of 1.7. Positive values brighten the image, negative values darken it.",Range(-1,1,0.05))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=GammaOffset,Title="Compensazione Gamma",Description="Si somma al gamma base di 1,7. Un valore positivo renderà l'immagine più chiara, un valore negativo più scura.",Range(-1,1,0.05))
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=LODBias,Title="Texture Sharpness",Description="How sharp world and model textures look. Sharper keeps the full-size texture visible from farther away. Softer blurs them sooner and reduces shimmer.",Value("-1.000000=Sharpest"),Value("-0.500000=Sharp"),Value("0.000000=Normal"),Value("0.500000=Soft"),Value("1.000000=Softest"))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=LODBias,Title="Nitidezza Texture",Description="Quanto appaiono nitide le texture del mondo e dei modelli. Più nitido mantiene visibile la texture a piena risoluzione da più lontano. Più morbido le sfoca prima e riduce lo sfarfallio.",Value("-1.000000=Massima nitidezza"),Value("-0.500000=Nitido"),Value("0.000000=Normale"),Value("0.500000=Morbido"),Value("1.000000=Massima morbidezza"))
; EN: Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=FramebufferBpc,Title="Framebuffer Depth",Description="Color depth of the framebuffer.",Value("8bpc=8 bits per channel"),Value("10bpc=10 bits per channel"),Value("16bpc=16 bits per channel"))
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=FramebufferBpc,Title="Profondità Framebuffer",Description="Profondità di colore del framebuffer.",Value("8bpc=8 bit per canale"),Value("10bpc=10 bit per canale"),Value("16bpc=16 bit per canale"))
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=OneXBlending,Title="One-X Blending",Description="If checked, uses DirectX 7 style lightmap blending, which looks more washed out.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=OneXBlending,Title="Fusione One-X",Description="Se attivo, usa la fusione delle lightmap in stile DirectX 7, che appare più sbiadita.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ActorXBlending,Title="Actor X Blending",Description="If checked, actors are lit at normal intensity. If unchecked, solid meshes are 1.5 times brighter.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ActorXBlending,Title="Fusione Actor X",Description="Se attivo, gli attori sono illuminati con intensità normale. Se disattivo, le mesh solide sono 1,5 volte più luminose.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=VolumetricLighting,Title="Volumetric Lighting",Description="If checked, enables volumetric lighting effects.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=VolumetricLighting,Title="Illuminazione Volumetrica",Description="Se attivo, abilita gli effetti di illuminazione volumetrica.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ShinySurfaces,Title="Shiny Surfaces",Description="If checked, enables reflective surfaces such as mirrors.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ShinySurfaces,Title="Superfici Riflettenti",Description="Se attivo, abilita le superfici riflettenti come gli specchi.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=Coronas,Title="Coronas",Description="If checked, enables light coronas.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=Coronas,Title="Corone Luminose",Description="Se attivo, abilita le corone luminose.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=HighDetailActors,Title="High Detail Actors",Description="If checked, renders actors at higher detail.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=HighDetailActors,Title="Attori ad Alto Dettaglio",Description="Se attivo, mostra gli attori con un dettaglio maggiore.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UsePrecache,Title="Precaching",Description="If checked, uploads level textures to the GPU during map load to reduce hitching.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UsePrecache,Title="Precaching",Description="Se attivo, carica le texture del livello sulla GPU durante il caricamento della mappa per ridurre gli scatti.")
; EN: Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseLightmapAtlas,Title="Lightmap Atlasing",Description="If checked, merges lightmaps into a single atlas texture.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseLightmapAtlas,Title="Atlante Lightmap",Description="Se attivo, unisce le lightmap in un'unica texture atlante.")
