[Public]
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseVSync,Title="Vertical Sync",Description="If checked, enables VSync to prevent screen tearing.")
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=UseAA,Title="Enable MSAA",Description="If checked, multisampled anti-aliasing will be enabled.")
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=NumAASamples,Title="MSAA Samples",Description="Number of samples for multisampled anti-aliasing.",Value(2),Value(4),Value(8))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MaxAnisotropy,Title="Max Anisotropy",Description="Anisotropic filtering level. Higher values keep textures sharper at an angle.",Value("0=Disabled"),Value("2=2x"),Value("4=4x"),Value("8=8x"),Value("16=16x"))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ForceNoSmooth,Title="No Texture Filtering",Description="If checked, disables texture filtering.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=MacroTextures,Title="Macro Textures",Description="If checked, enables macro textures on surfaces.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=DetailTextures,Title="Detail Textures",Description="If checked, enables detail textures on surfaces.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseGammaCorrection,Title="Gamma Correction",Description="If checked, enables post-process gamma correction.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=GammaOffset,Title="Gamma Offset",Description="Added to the base gamma of 1.7. Positive values brighten the image, negative values darken it.",Range(-1,1,0.05))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=LODBias,Title="Texture Sharpness",Description="How sharp world and model textures look. Sharper keeps the full-size texture visible from farther away. Softer blurs them sooner and reduces shimmer.",Value("-1.000000=Sharpest"),Value("-0.500000=Sharp"),Value("0.000000=Normal"),Value("0.500000=Soft"),Value("1.000000=Softest"))
Property=(Config,RequireRestart,Class=FruCoRe.FruCoReRenderDevice,Name=FramebufferBpc,Title="Framebuffer Depth",Description="Color depth of the framebuffer.",Value("8bpc=8 bits per channel"),Value("10bpc=10 bits per channel"),Value("16bpc=16 bits per channel"))
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=OneXBlending,Title="One-X Blending",Description="If checked, uses DirectX 7 style lightmap blending, which looks more washed out.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ActorXBlending,Title="Actor X Blending",Description="If checked, actors are lit at normal intensity. If unchecked, solid meshes are 1.5 times brighter.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=VolumetricLighting,Title="Volumetric Lighting",Description="If checked, enables volumetric lighting effects.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=ShinySurfaces,Title="Shiny Surfaces",Description="If checked, enables reflective surfaces such as mirrors.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=Coronas,Title="Coronas",Description="If checked, enables light coronas.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=HighDetailActors,Title="High Detail Actors",Description="If checked, renders actors at higher detail.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UsePrecache,Title="Precaching",Description="If checked, uploads level textures to the GPU during map load to reduce hitching.")
Property=(Config,Class=FruCoRe.FruCoReRenderDevice,Name=UseLightmapAtlas,Title="Lightmap Atlasing",Description="If checked, merges lightmaps into a single atlas texture.")

